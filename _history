e=\"math_number\"><field name=\"NUM\">0</field></shadow><block type=\"variables_get\"><field name=\"VAR\" id=\"D:i1tExm@HWw[}=uEssW\">varighetSekunder</field></block></value><value name=\"B\"><shadow type=\"math_number\"><field name=\"NUM\">1000</field></shadow></value></block></value></block></value><next><block type=\"variables_set\"><field name=\"VAR\" id=\"{6=Zr1T(xw{TYYL`=%(v\">sistVistSekund</field><value name=\"VALUE\"><shadow type=\"math_number\"><field name=\"NUM\">-1</field></shadow></value><next><block type=\"VIEW128x64_clear\"><next><block type=\"variables_set\"><field name=\"VAR\" id=\"`sG89*8v[)s?LfG=K)`9\">nedtelling</field><value name=\"VALUE\"><shadow type=\"math_number\"><field name=\"NUM\">0</field></shadow><block type=\"logic_boolean\"><field name=\"BOOL\">TRUE</field></block></value></block></next></block></next></block></next></block></next></block></next></block></statement></block></xml>","main.ts":"function toSifre (tall: number) {\n    if (tall < 10) {\n        return \"0\" + tall\n    }\n    return \"\" + tall\n}\nfunction stoppNedtelling (tekst: string) {\n    nedtelling = false\n    strip.showColor(neopixel.colors(NeoPixelColors.Green))\n    strip.show()\n    kitronik_VIEW128x64.clear()\n    visMelding(tekst)\n}\ninput.onButtonPressed(Button.A, function () {\n    startNedtelling()\n})\nfunction visMelding (tekst: string) {\n    kitronik_VIEW128x64.show(tekst, 1, kitronik_VIEW128x64.ShowAlign.Centre)\n}\ninput.onButtonPressed(Button.B, function () {\n    stoppNedtelling(\"DESARMERT\")\n})\nradio.onReceivedString(function (melding) {\n    if (melding == \"START\") {\n        startNedtelling()\n    }\n})\nfunction startNedtelling () {\n    if (nedtelling) {\n        return\n    }\n    for (let indeks = 0; indeks <= antall_NeoPixels - 1; indeks++) {\n        rodStyrke = Math.idiv(indeks * 256, antall_NeoPixels)\n        strip.setPixelColor(indeks, neopixel.rgb(rodStyrke, rodStyrke, 0))\n    }\n    sluttTid = input.runningTime() + varighetSekunder * 1000\n    sistVistSekund = -1\n    kitronik_VIEW128x64.clear()\n    nedtelling = true\n}\nlet sekunder = 0\nlet minutter = 0\nlet sekunderIgjen = 0\nlet tidIgjenMs = 0\nlet sluttTid = 0\nlet rodStyrke = 0\nlet nedtelling = false\nlet strip: neopixel.Strip = null\nlet antall_NeoPixels = 0\nlet sistVistSekund = 0\nlet varighetSekunder = 0\nlet varighetTimer = 1\nlet varighetMinutter = 30\nvarighetSekunder = varighetTimer * 3600 + varighetMinutter * 60\nsistVistSekund = -1\nantall_NeoPixels = 16\nstrip = neopixel.create(DigitalPin.P12, antall_NeoPixels, NeoPixelMode.RGB)\nstrip.clear()\nstrip.show()\nMFRC522.Init()\nradio.setGroup(23)\nkitronik_VIEW128x64.controlDisplayOnOff(kitronik_VIEW128x64.onOff(true))\nkitronik_VIEW128x64.setFontSize(kitronik_VIEW128x64.FontSelection.Giant)\nvisMelding(\"KLAR\")\nbasic.forever(function () {\n    if (nedtelling) {\n        tidIgjenMs = sluttTid - input.runningTime()\n        if (tidIgjenMs <= 0) {\n            stoppNedtelling(\"00:00\")\n        } else {\n            sekunderIgjen = Math.idiv(tidIgjenMs + 999, 1000)\n            if (sekunderIgjen != sistVistSekund) {\n                sistVistSekund = sekunderIgjen\n                minutter = Math.idiv(sekunderIgjen, 60)\n                sekunder = sekunderIgjen % 60\n                visMelding(\"\" + toSifre(minutter) + \":\" + toSifre(sekunder))\n            }\n            if (MFRC522.read() == \"DESARMER BOMBEN!!!!\") {\n                stoppNedtelling(\"DEAKTIVERT\")\n            }\n        }\n    }\n})\nbasic.forever(function () {\n    strip.rotate(1)\n    strip.show()\n    basic.pause(100)\n})\n","README.md":"","pxt.json":"{\n    \"name\": \"TEST boks\",\n    \"description\": \"\",\n    \"dependencies\": {\n        \"core\": \"*\",\n        \"radio\": \"*\",\n        \"microphone\": \"*\",\n        \"pxt-mfrc522\": \"github:joy-it/pxt-rfid-mfrc522#1.0.1\",\n        \"neopixel\": \"github:microsoft/pxt-neopixel#v0.7.6\",\n        \"OLED-skjerm\": \"github:oysa88/oled-s